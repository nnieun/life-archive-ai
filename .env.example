LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma4:e2b
OLLAMA_BASE_URL=http://localhost:11434/v1
# QA speed profile.
QA_COMBINED=true
QA_COMPACT=true
QA_CACHE_ENABLED=true
QA_NATIVE_OLLAMA=true
QA_VERIFICATION_MODEL=
QA_MAX_TOKENS=768
QA_MAX_REWRITES=0
OLLAMA_KEEP_ALIVE=15m
# OPENAI_API_KEY is only needed when selecting an OpenAI provider.
# Copy this file to .env and set your own key locally.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=bge-m3
SQLITE_DATABASE_PATH=data/db/life_archive.sqlite3
CHROMA_PERSIST_DIRECTORY=data/indexes/chroma
TRANSCRIPT_UPLOAD_DIRECTORY=data/raw/transcripts
APP_ENV=development
LIFE_ARCHIVE_API_URL=http://127.0.0.1:8000/api/v1
